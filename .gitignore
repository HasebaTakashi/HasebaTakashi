# Ignore bundler cache.
vendor/bundle

# Ignore the default sqlite database.
*.sqlite3
*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp

*.gem
*.rbc
.bundle
.config
Gemfile.lock
/vendor/bundle/
/vendor/cache/
/vendor/gems/
/vendor/ruby/

# Ignore files generated by rspec
.rspec
/spec/reports/

# Ignore files generated by ci
/coverage/
/ci/reports/

# Ignore local files
.local
.env*
*.swp
*~
.idea/
.vscode/

# Ignore mac os files
.DS_Store
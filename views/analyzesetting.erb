<h2>Analyzer Settings</h2>
<p class="text-body-secondary">Configure, enable, or disable analyzers.</p>
<hr>

<form action="editanalyze" method="POST" class="mt-4">
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Data Ch. ID</th>
          <th>Type</th>
          <th>Path</th>
          <th>Command</th>
          <th>Arguments</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @analyze_settings.each do |setting| %>
          <tr>
            <th scope="row"><%= setting.analyze_id %></th>
            <td><input type="text" class="form-control" name="analyzename<%= setting.analyze_id %>" value="<%= setting.analyze_name %>"></td>
            <td><input type="number" class="form-control" name="datachannelid<%= setting.analyze_id %>" value="<%= setting.data_channel_id %>" min="0" max="99"></td>
            <td><input type="text" class="form-control" name="analyzetype<%= setting.analyze_id %>" value="<%= setting.analyze_type %>"></td>
            <td><input type="text" class="form-control" name="analyzepath<%= setting.analyze_id %>" value="<%= setting.analyze_path %>"></td>
            <td><input type="text" class="form-control" name="analyzecommand<%= setting.analyze_id %>" value="<%= setting.analyze_command %>"></td>
            <td><input type="text" class="form-control" name="analyzearguments<%= setting.analyze_id %>" value="<%= setting.analyze_arguments %>"></td>
            <td>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="analyzeenable<%= setting.analyze_id %>" id="analyze_<%= setting.analyze_id %>_enable" value="1" <%= 'checked' if setting.enable_analyze != 0 %>>
                <label class="form-check-label" for="analyze_<%= setting.analyze_id %>_enable">Enable</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="analyzeenable<%= setting.analyze_id %>" id="analyze_<%= setting.analyze_id %>_disable" value="0" <%= 'checked' if setting.enable_analyze == 0 %>>
                <label class="form-check-label" for="analyze_<%= setting.analyze_id %>_disable">Disable</label>
              </div>
            </td>
            <td>
              <a href="/deleteanalyze/<%= setting.analyze_id %>" class="btn btn-sm btn-danger">Delete</a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <hr>
  <div class="d-flex justify-content-between">
    <div>
      <a href="/" class="btn btn-secondary">Back to Home</a>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
    <div>
      <a href="/addanalyze" class="btn btn-success">Add New Analyzer</a>
    </div>
  </div>
</form>

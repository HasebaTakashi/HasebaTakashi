<h2><%= @title %></h2>
<form action="/<%= @config_key %>" method="post">
  <% @config_data.each do |channel_key, channel_data| %>
    <fieldset>
      <legend><%= h(channel_key) %></legend>
      <div class="form-grid">
        <% channel_data.each do |prop, value| %>
          <div class="form-group">
            <label for="<%= channel_key %>_<%= prop %>"><%= h(prop) %></label>
            <input type="text" id="<%= channel_key %>_<%= prop %>" name="<%= @config_key %>[<%= channel_key %>][<%= prop %>]" value="<%= h(value) %>">
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <button type="submit">Save Changes</button>
</form>

<section class="settings-card">
    <h3>Analyze App Setting</h3>
    <form action="editanalyzeapp" method="POST">
        <div class="form-grid">
            <div class="form-group">
                <label for="samplingserverip">SamplingServerIP</label>
                <input type="text" id="samplingserverip" name="samplingserverip" value="<%= @analyze_app_setting.sampling_server_ip %>">
            </div>
            <div class="form-group">
                <label for="samplingserverport">SamplingServerPort</label>
                <input type="number" id="samplingserverport" name="samplingserverport" value="<%= @analyze_app_setting.sampling_server_port %>" min="10000" max="65536">
            </div>
            <div class="form-group">
                <label for="mqtthostip">MqttHostIP</label>
                <input type="text" id="mqtthostip" name="mqtthostip" value="<%= @analyze_app_setting.mqtt_host_ip %>">
            </div>
            <div class="form-group">
                <label for="mqttport">MqttPort</label>
                <input type="number" id="mqttport" name="mqttport" value="<%= @analyze_app_setting.mqtt_port %>" min="1" max="65536">
            </div>
            <div class="form-group">
                <label for="mqttsendtopic">MqttSendTopic</label>
                <input type="text" id="mqttsendtopic" name="mqttsendtopic" value="<%= @analyze_app_setting.mqtt_send_topic %>">
            </div>
            <div class="form-group">
                <label for="triggertype">TriggerType</label>
                <input type="number" id="triggertype" name="triggertype" value="<%= @analyze_app_setting.trigger_type %>" min="0" max="2">
            </div>
            <div class="form-group">
                <label for="measurementsec">MeasurementSec</label>
                <input type="number" id="measurementsec" name="measurementsec" value="<%= @analyze_app_setting.measurement_sec %>" min="1" max="180">
            </div>
            <div class="form-group">
                <label for="measurementintervalsec">MeasurementIntervalSec</label>
                <input type="number" id="measurementintervalsec" name="measurementintervalsec" value="<%= @analyze_app_setting.measurement_interval_sec %>" min="0" max="65536">
            </div>
            <div class="form-group">
                <label for="pretriggersec">PreTriggerSec</label>
                <input type="number" id="pretriggersec" name="pretriggersec" value="<%= @analyze_app_setting.pretrigger_sec %>" min="0" max="180">
            </div>
            <div class="form-group">
                <label for="triggerinputdeviceid">TriggerInputDeviceID</label>
                <input type="number" id="triggerinputdeviceid" name="triggerinputdeviceid" value="<%= @analyze_app_setting.trigger_device_id %>" min="0" max="99">
            </div>
            <div class="form-group">
                <label for="triggerinputchannelid">TriggerInputChannelID</label>
                <input type="number" id="triggerinputchannelid" name="triggerinputchannelid" value="<%= @analyze_app_setting.trigger_channel_id %>" min="0" max="99">
            </div>
            <div class="form-group">
                <label>OutputData</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="isoutputdata" value="1" <%= 'checked' if @analyze_app_setting.is_output_data == 1 %>>
                        Enable
                    </label>
                    <label>
                        <input type="radio" name="isoutputdata" value="0" <%= 'checked' if @analyze_app_setting.is_output_data == 0 %>>
                        Disable
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label for="maxoutputfileno">MaxOutputFileNo</label>
                <input type="number" id="maxoutputfileno" name="maxoutputfileno" value="<%= @analyze_app_setting.max_output_file_no %>" min="1" max="200">
            </div>
            <div class="form-group">
                <label for="outputdatasec">OutputDataSec</label>
                <input type="number" id="outputdatasec" name="outputdatasec" value="<%= @analyze_app_setting.output_data_sec %>" min="1" max="3600">
            </div>
            <div class="form-group">
                <label for="outputdatapath">OutputDataPath</label>
                <input type="text" id="outputdatapath" name="outputdatapath" value="<%= @analyze_app_setting.output_data_path %>">
            </div>
        </div>
        <button type="submit" class="btn">Edit</button>
    </form>
</section>

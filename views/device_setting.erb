<div class="card">
  <div class="card-header">
    <h3><i class="bi bi-hdd-stack"></i> デバイス設定</h3>
  </div>
  <div class="card-body">
    <p class="card-text">各デバイスの有効/無効を切り替えます。</p>
    <form action="/editdevice" method="post">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">デバイスID</th>
            <th scope="col">デバイス名</th>
            <th scope="col">チャンネル数</th>
            <th scope="col" class="text-center">有効/無効</th>
          </tr>
        </thead>
        <tbody>
          <% @device_settings.each do |setting| %>
            <tr>
              <th scope="row"><%= setting.device_id %></th>
              <td><%= setting.device_name %></td>
              <td><%= setting.channel_no %></td>
              <td class="text-center">
                <div class="form-check form-switch d-inline-block">
                  <input type="hidden" name="deviceenable<%= setting.device_id %>" value="0">
                  <input class="form-check-input" type="checkbox" role="switch" id="deviceenable<%= setting.device_id %>" name="deviceenable<%= setting.device_id %>" value="1" <%= 'checked' if setting.enable_device == 1 %>>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> 設定を保存</button>
      </div>
    </form>
  </div>
</div>

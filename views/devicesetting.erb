<h2>Device Settings</h2>
<p class="text-body-secondary">Enable or disable the available devices.</p>
<hr>

<form action="editdevice" method="POST" class="mt-4">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th scope="col">Device ID</th>
        <th scope="col">Device Name</th>
        <th scope="col">Channel No.</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @device_settings.each do |setting| %>
        <tr>
          <th scope="row"><%= setting.device_id %></th>
          <td><%= setting.device_name %></td>
          <td><%= setting.channel_no %></td>
          <td>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="deviceenable<%= setting.device_id %>" id="device_<%= setting.device_id %>_enable" value="1" <%= 'checked' if setting.enable_device != 0 %>>
              <label class="form-check-label" for="device_<%= setting.device_id %>_enable">Enable</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="deviceenable<%= setting.device_id %>" id="device_<%= setting.device_id %>_disable" value="0" <%= 'checked' if setting.enable_device == 0 %>>
              <label class="form-check-label" for="device_<%= setting.device_id %>_disable">Disable</label>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <hr>
  <a href="/" class="btn btn-secondary">Back to Home</a>
  <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

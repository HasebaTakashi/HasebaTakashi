<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>設定アプリ - <%= @title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">設定アプリ</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/samplingappsetting">サンプリングアプリ設定</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/devicesetting">デバイス設定</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/channelsetting">チャンネル設定</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/analyzeappsetting">分析アプリ設定</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/analyzesetting">分析設定</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container mt-4">
      <% if @error %>
        <div class="alert alert-danger" role="alert">
          <%= @error %>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="container mt-5 py-3 text-center text-muted">
      <p>Version: <%= @version %></p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>

<section class="settings-card">
    <h3>Device Setting</h3>
    <form action="editdevice" method="POST">
        <table class="settings-table">
            <thead>
                <tr>
                    <th>DeviceID</th>
                    <th>DeviceName</th>
                    <th>ChannelNo</th>
                    <th>Enable</th>
                </tr>
            </thead>
            <tbody>
                <% @device_settings.each do |setting| %>
                    <tr>
                        <td data-label="DeviceID"><%= setting.device_id %></td>
                        <td data-label="DeviceName"><%= setting.device_name %></td>
                        <td data-label="ChannelNo"><%= setting.channel_no %></td>
                        <td data-label="Enable">
                            <div class="radio-group">
                                <label>
                                    <input type="radio" name="deviceenable<%= setting.device_id %>" value="1" <%= 'checked' if setting.enable_device == 1 %>>
                                    Enable
                                </label>
                                <label>
                                    <input type="radio" name="deviceenable<%= setting.device_id %>" value="0" <%= 'checked' if setting.enable_device == 0 %>>
                                    Disable
                                </label>
                            </div>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
        <button type="submit" class="btn">Edit</button>
    </form>
</section>

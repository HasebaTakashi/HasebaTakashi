<h2><%= @title %></h2>
<form action="/<%= @config_key %>" method="post">
  <% @config_data.each do |device_key, device_data| %>
    <fieldset>
      <legend><%= h(device_key) %></legend>
      <div class="form-grid">
        <% device_data.each do |prop, value| %>
          <div class="form-group">
            <label for="<%= device_key %>_<%= prop %>"><%= h(prop) %></label>
            <% if prop.to_s.downcase.include?('enable') %>
              <div class="radio-group">
                <label>
                  <input type="radio" name="<%= @config_key %>[<%= device_key %>][<%= prop %>]" value="1" <%= 'checked' if value == 1 %>>
                  Enable
                </label>
                <label>
                  <input type="radio" name="<%= @config_key %>[<%= device_key %>][<%= prop %>]" value="0" <%= 'checked' if value == 0 %>>
                  Disable
                </label>
              </div>
            <% else %>
              <input type="text" id="<%= device_key %>_<%= prop %>" name="<%= @config_key %>[<%= device_key %>][<%= prop %>]" value="<%= h(value) %>">
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <button type="submit">Save Changes</button>
</form>
